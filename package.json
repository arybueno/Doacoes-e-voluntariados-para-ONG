{
  "name": "doacoes-e-voluntariados-para-ong",
  "version": "1.0.0",
  "description": "API para gerenciar campanhas, doações e ações de voluntariado de ONGs",
  "main": "src/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:up": "docker start mongo-ong || docker run -d --name mongo-ong -p 127.0.0.1:27017:27017 -v mongo-ong-data:/data/db mongo:8",
    "db:down": "docker stop mongo-ong",
    "db:logs": "docker logs -f mongo-ong",
    "db:reset": "docker rm -f mongo-ong; docker volume rm mongo-ong-data",
    "predev": "npm run db:up",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arybueno/Doacoes-e-voluntariados-para-ONG.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/arybueno/Doacoes-e-voluntariados-para-ONG/issues"
  },
  "homepage": "https://github.com/arybueno/Doacoes-e-voluntariados-para-ONG#readme",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "mongodb": "^7.8.0"
  }
}
